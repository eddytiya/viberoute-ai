# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is already in .gitignore.

# --- App ---
ENVIRONMENT=development
FRONTEND_URL=http://127.0.0.1:5173

# --- Session cookie signing key (any long random string, keep it secret) ---
SESSION_SECRET_KEY=change-me-to-a-random-string

# --- Spotify (from developer.spotify.com/dashboard -> your app -> Basic Information) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must be added EXACTLY as a Redirect URI in the Spotify dashboard app settings
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback

# --- LLM provider (needed for Playlist Architect / Music Critic features) ---
# Free tier, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional, not used by default
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Route directions (needed for Smart Route Playlist Sync) ---
# Free tier, no card required: https://openrouteservice.org/dev/#/signup
OPENROUTE_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Database / cache (not required yet for the OAuth slice) ---
DATABASE_URL=
REDIS_URL=
